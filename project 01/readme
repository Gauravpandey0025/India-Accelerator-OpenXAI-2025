    <script>
        // Mobile menu toggle
        document.getElementById('mobile-menu').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu-content');
            menu.classList.toggle('hidden');
        });

        // Smooth scrolling
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                    // Close mobile menu if open
                    document.getElementById('mobile-menu-content').classList.add('hidden');
                }
            });
        });

        // Initialize charts
        function initializeCharts() {
            // Weather Chart
            const weatherCtx = document.getElementById('weatherChart').getContext('2d');
            new Chart(weatherCtx, {
                type: 'line',
                data: {
                    labels: ['Now', '+6h', '+12h', '+18h', '+24h', '+30h', '+36h'],
                    datasets: [{
                        label: 'Temperature (°F)',
                        data: [72, 68, 65, 70, 75, 72, 68],
                        borderColor: '#059669',
                        backgroundColor: 'rgba(5, 150, 105, 0.1)',
                        tension: 0.4,
                        fill: true
                    }, {
                        label: 'Rainfall (in)',
                        data: [0, 0.2, 0.8, 0.3, 0.1, 0, 0],
                        borderColor: '#3b82f6',
                        backgroundColor: 'rgba(59, 130, 246, 0.1)',
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            position: 'top',
                        }
                    }
                }
            });

            // Correlation Chart
            const correlationCtx = document.getElementById('correlationChart').getContext('2d');
            new Chart(correlationCtx, {
                type: 'bar',
                data: {
                    labels: ['Soil Moisture', 'Temperature', 'Rainfall', 'Nutrients', 'pH Level'],
                    datasets: [{
                        label: 'Correlation with Yield',
                        data: [0.85, 0.62, 0.78, 0.91, 0.67],
                        backgroundColor: [
                            'rgba(5, 150, 105, 0.8)',
                            'rgba(59, 130, 246, 0.8)',
                            'rgba(249, 115, 22, 0.8)',
                            'rgba(139, 92, 246, 0.8)',
                            'rgba(236, 72, 153, 0.8)'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: {
                            display: false
                        },
                        title: {
                            display: true,
                            text: 'Data Correlation with Crop Yield'
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 1.0
                        }
                    }
                }
            });
        }

        // Simulate live data updates
        function simulateLiveData() {
            // Update sensor counts with random variations
            setInterval(() => {
                const weatherStations = document.getElementById('weather-stations');
                const soilSensors = document.getElementById('soil-sensors');
                const satelliteScans = document.getElementById('satellite-scans');
                
                weatherStations.textContent = Math.floor(12 + Math.random() * 2);
                soilSensors.textContent = Math.floor(47 + Math.random() * 3);
                satelliteScans.textContent = Math.floor(3 + Math.random() * 2);
                
                // Update soil metrics with small variations
                document.getElementById('soil-moisture').textContent = 
                    Math.floor(40 + Math.random() * 5) + '%';
                document.getElementById('soil-nutrients').textContent = 
                    Math.floor(75 + Math.random() * 6) + '%';
                document.getElementById('soil-ph').textContent = 
                    (6.5 + Math.random() * 0.5).toFixed(1);
                
            }, 5000);
        }

        // Initialize everything when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeCharts();
            simulateLiveData();
            
            // Add live pulse animation to key elements
            const liveElements = document.querySelectorAll('#weather-stations, #soil-sensors, #satellite-scans');
            liveElements.forEach(el => {
                el.classList.add('live-pulse');
            });
        });
    </script>
